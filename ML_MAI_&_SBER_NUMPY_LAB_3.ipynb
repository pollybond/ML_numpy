      "source": [
        "def scalar_product(a, b):\n",
        "    \"\"\"\n",
        "    Вычисляет скалярное произведение двух векторов.\n",
        "\n",
        "    Параметры\n",
        "    ----------\n",
        "    a : np.array, shape (n,)\n",
        "        Первый вектор длиной n.\n",
        "    b : np.array, shape (n,)\n",
        "        Второй вектор длиной n.\n",
        "\n",
        "    Возвращает\n",
        "    -------\n",
        "    c : float\n",
        "        Результат скалярного произведения векторов a и b.\n",
        "\n",
        "    Примеры\n",
        "    --------\n",
        "    >>> a = np.array([1, 2, 3])\n",
        "    >>> b = np.array([4, 5, 6])\n",
        "    >>> scalar_product(a, b)\n",
        "    32.0\n",
        "\n",
        "    Примечания\n",
        "    ----------\n",
        "    Функция реализует скалярное умножение векторов без использования специализированных\n",
        "    функций из пакета numpy.\n",
        "    \"\"\"\n",
        "    return sum(a[i] * b[i] for i in range(len(a)))"
      ],
