        "def np_mult(a, b):\n",
        "    \"\"\"\n",
        "    Вычисляет произведение двух квадратных матриц с использованием NumPy.\n",
        "\n",
        "    Параметры\n",
        "    ----------\n",
        "    a : np.array, shape (size, size)\n",
